# Kredensial lokal untuk skrip terminal; bukan konfigurasi frontend.
# Isi hanya layanan yang akan dipakai. Nilai rahasia tetap kosong di contoh ini.
# Panduan: docs/API-ACCESS.md. Jangan unggah .env atau memasukkannya ke HTML/JS.

# Cloudflare REST API: gunakan API Token, bukan Global API Key.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=767723b319b506885ae681dc3e0eec9e
CLOUDFLARE_ZONE_ID=1fd30bdf5bea0369714c7dfe6db1c143
CLOUDFLARE_PAGES_PROJECT_NAME=

# R2 S3: pasangan kunci khusus R2, berbeda dari token REST Cloudflare.
R2_BUCKET_NAME=erojan-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://767723b319b506885ae681dc3e0eec9e.r2.cloudflarestorage.com
R2_REGION=auto

# Google Ads: OAuth pribadi + level akses pada proyek Google Cloud.
# Panduan migrasi Google: developer token sunset 9 September 2026.
# Variabel developer token dipertahankan hanya untuk kompatibilitas alat lama.
GOOGLE_PROJECT_ID=
GOOGLE_ADS_API_VERSION=v26
# Customer ID sengaja kosong: akun yang berhasil diaudit memiliki kampanye DVN.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Isi hanya bila akses melalui akun manager/MCC, tanpa tanda hubung.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_USE_PROTO_PLUS=true

# Google Workspace, Analytics, Search Console: OAuth terpisah dari Ads.
# Cakupan persetujuan dan API aktif menentukan layanan yang dapat dipakai.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Opsional: path absolut file service account lokal yang diabaikan Git.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_SEARCH_CONSOLE_SITE_URL=

# GitHub: personal access token dengan akses repositori yang diperlukan.
GITHUB_TOKEN=

# Akun API pribadi untuk layanan yang sebelumnya memakai akun instan Composio.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
ELEVENLABS_API_KEY=
TINYFISH_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_ORG_ID=

# Integrasi opsional yang belum aktif pada audit Composio.
META_ADS_ACCESS_TOKEN=
META_ADS_AD_ACCOUNT_ID=
SLACK_BOT_TOKEN=
SLACK_USER_TOKEN=
NOTION_TOKEN=
